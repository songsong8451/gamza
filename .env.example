# ==========================================
# Supabase & MCP 설정 템플릿 (.env.example)
# ==========================================

# 1. Supabase 프로젝트 기본 정보
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Supabase MCP 및 CLI 연동
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your-personal-access-token

# 3. PostgreSQL 데이터베이스 직접 연결
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
SUPABASE_DB_PASSWORD=your-db-password
